{
  "name": "vscode-katana-markdown-linter",
  "displayName": "KatanA Markdown Linter",
  "description": "VS Code extension for KatanA Markdown Linter (kml)",
  "version": "0.20.0",
  "publisher": "HiroyukiFuruno",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "KatanA Markdown Linter",
      "properties": {
        "kml.executablePath": {
          "type": "string",
          "default": "kml",
          "description": "Path to the kml executable."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": ".markdownlint.json",
        "url": "https://raw.githubusercontent.com/HiroyukiFuruno/katana-markdown-linter/main/schema/markdownlint.schema.json"
      },
      {
        "fileMatch": ".markdownlint.jsonc",
        "url": "https://raw.githubusercontent.com/HiroyukiFuruno/katana-markdown-linter/main/schema/markdownlint.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "18.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  }
}
